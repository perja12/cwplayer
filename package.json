{
  "name": "cw-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:js": "eslint . --max-warnings=0 --cache",
    "lint:css": "stylelint \"src/**/*.css\" --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache",
    "typecheck": "tsc -b",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test:arch && pnpm run test:coverage",
    "verify": "pnpm run check && pnpm test",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:arch": "vitest run --config vitest.arch.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:related": "vitest related --run --config vitest.unit.config.ts",
    "test:coverage": "vitest run --config vitest.unit.config.ts --coverage",
    "build:wasm": "sh scripts/build-wasm.sh"
  },
  "dependencies": {
    "xstate": "^5.20.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "stylelint": "^18.0.0",
    "stylelint-config-recommended": "^19.0.0",
    "tsarch": "^5.4.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  }
}
